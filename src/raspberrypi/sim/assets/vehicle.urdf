<?xml version="1.0"?>
<robot name="echo_sim_car">
  <material name="chassis"><color rgba="0.08 0.16 0.22 1"/></material>
  <material name="wheel"><color rgba="0.04 0.04 0.04 1"/></material>
  <material name="knuckle"><color rgba="0.35 0.35 0.35 1"/></material>
  <link name="base_link">
    <inertial><origin xyz="0 0 0.065"/><mass value="0.62"/><inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0035" iyz="0" izz="0.0040"/></inertial>
    <visual><origin xyz="0 0 0.065"/><geometry><box size="0.25 0.11 0.07"/></geometry><material name="chassis"/></visual>
    <collision><origin xyz="0 0 0.065"/><geometry><box size="0.25 0.11 0.07"/></geometry></collision>
  </link>

  <link name="rear_left_wheel"><inertial><mass value="0.02"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.046" length="0.018"/></geometry><material name="wheel"/></visual><collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.046" length="0.018"/></geometry></collision></link>
  <joint name="rear_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_left_wheel"/><origin xyz="-0.09 0.061 0.046"/><axis xyz="0 1 0"/></joint>
  <link name="rear_right_wheel"><inertial><mass value="0.02"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.046" length="0.018"/></geometry><material name="wheel"/></visual><collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.046" length="0.018"/></geometry></collision></link>
  <joint name="rear_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_right_wheel"/><origin xyz="-0.09 -0.061 0.046"/><axis xyz="0 1 0"/></joint>

  <link name="front_left_knuckle"><inertial><mass value="0.005"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial><visual><geometry><box size="0.015 0.015 0.025"/></geometry><material name="knuckle"/></visual></link>
  <joint name="front_left_steer_joint" type="revolute"><parent link="base_link"/><child link="front_left_knuckle"/><origin xyz="0.09 0.061 0.046"/><axis xyz="0 0 1"/><limit lower="-0.7" upper="0.7" effort="4" velocity="6"/></joint>
  <link name="front_left_wheel"><inertial><mass value="0.02"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.046" length="0.018"/></geometry><material name="wheel"/></visual><collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.046" length="0.018"/></geometry></collision></link>
  <joint name="front_left_wheel_joint" type="continuous"><parent link="front_left_knuckle"/><child link="front_left_wheel"/><axis xyz="0 1 0"/></joint>

  <link name="front_right_knuckle"><inertial><mass value="0.005"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial><visual><geometry><box size="0.015 0.015 0.025"/></geometry><material name="knuckle"/></visual></link>
  <joint name="front_right_steer_joint" type="revolute"><parent link="base_link"/><child link="front_right_knuckle"/><origin xyz="0.09 -0.061 0.046"/><axis xyz="0 0 1"/><limit lower="-0.7" upper="0.7" effort="4" velocity="6"/></joint>
  <link name="front_right_wheel"><inertial><mass value="0.02"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.046" length="0.018"/></geometry><material name="wheel"/></visual><collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.046" length="0.018"/></geometry></collision></link>
  <joint name="front_right_wheel_joint" type="continuous"><parent link="front_right_knuckle"/><child link="front_right_wheel"/><axis xyz="0 1 0"/></joint>
</robot>
